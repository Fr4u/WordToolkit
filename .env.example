# Local Docker values only. Replace both secrets before starting.
WORDTOOLKIT_DEVELOPMENT_BEARER_TOKEN=replace-with-a-long-random-local-token
WORDTOOLKIT_SIGNING_SECRET=replace-with-at-least-32-random-characters
WORDTOOLKIT_SESSION_TTL_SECONDS=3600
WORDTOOLKIT_ARTIFACT_TTL_SECONDS=3600
WORDTOOLKIT_MAX_SESSIONS_PER_OWNER=5
WORDTOOLKIT_MAX_DOCUMENTS_PER_SESSION=20
WORDTOOLKIT_MAX_ARTIFACTS_PER_OWNER=100
WORDTOOLKIT_MAX_SESSION_BYTES=536870912
WORDTOOLKIT_MAX_ARTIFACT_BYTES_PER_OWNER=1073741824
WORDTOOLKIT_MAX_UPLOAD_BYTES=52428800
WORDTOOLKIT_MAX_REQUEST_BYTES=2097152
WORDTOOLKIT_MAX_UNCOMPRESSED_BYTES=262144000
WORDTOOLKIT_MAX_ZIP_ENTRIES=5000
WORDTOOLKIT_MAX_COMPRESSION_RATIO=100
WORDTOOLKIT_CORS_ALLOWED_ORIGINS=https://chatgpt.com
