<Project>
  <PropertyGroup>
    <!-- Release base version: runtime serverInfo and plugin packaging must agree. -->
    <WordToolkitVersion>0.61.0</WordToolkitVersion>
    <Version>$(WordToolkitVersion)</Version>
    <AssemblyVersion>0.61.0.0</AssemblyVersion>
    <FileVersion>0.61.0.0</FileVersion>
    <InformationalVersion>$(WordToolkitVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Keep compiler debug metadata independent of the checkout directory. Without an
         explicit map, a deterministic assembly still records the absolute PDB path and
         therefore differs between local builds and GitHub-hosted runners. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
</Project>
