<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>wordtoolkit-native</AssemblyName>
    <RootNamespace>WordToolkit.Native</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <WordToolkitLocalSchemaPath Condition="'$(WordToolkitLocalSchemaPath)' == ''">$(MSBuildThisFileDirectory)..\..\schemas\mcp-tools-local.v1.json</WordToolkitLocalSchemaPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WordToolkit.Engine/WordToolkit.Engine.csproj" />
    <ProjectReference Include="../WordToolkit.LibreOffice/WordToolkit.LibreOffice.csproj" />
    <ProjectReference Include="../WordToolkit.OpenXmlSdk/WordToolkit.OpenXmlSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(WordToolkitLocalSchemaPath)"
                      Link="Schemas/mcp-tools-local.v1.json" />
    <EmbeddedResource Include="../../schemas/wordtoolkit-capabilities.v1.schema.json"
                      Link="Schemas/wordtoolkit-capabilities.v1.schema.json" />
    <EmbeddedResource Include="../../schemas/action-guidance.v1.json"
                      Link="Schemas/action-guidance.v1.json" />
  </ItemGroup>
</Project>
